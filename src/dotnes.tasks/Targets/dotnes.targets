<Project InitialTargets="_ValidateNESTestProject">
  <Target Name="_ValidateNESTestProject"
          Condition="('$(_NESIsTestProject)' == 'false' and '$(IsTestProject)' == 'true') or ('$(_NESIsTestProject)' == 'true' and '$(IsTestProject)' != 'true')">
    <Error Text="dotnes: IsTestProject changed after package props were evaluated. Use Microsoft.NET.Test.Sdk or set IsTestProject in Directory.Build.props; do not change it in the project body." />
  </Target>
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <NESTargetPath>$(OutputPath)$(TargetName).nes</NESTargetPath>
    <_NESPropertiesStampFile>$(IntermediateOutputPath)dotnes.properties.stamp</_NESPropertiesStampFile>
    <_NESTasksAssembly>$(MSBuildThisFileDirectory)dotnes.tasks.dll</_NESTasksAssembly>
    <TranspileDependsOn>$(TranspileDependsOn);_WriteNESPropertiesStamp</TranspileDependsOn>
    <IncrementalCleanDependsOn>$(IncrementalCleanDependsOn);Transpile</IncrementalCleanDependsOn>
  </PropertyGroup>
  <!-- Local dev: run task out-of-process so the build server doesn't lock dotnes.tasks.dll -->
  <UsingTask TaskName="dotnes.TranspileToNES" AssemblyFile="$(_NESTasksAssembly)"
             TaskFactory="TaskHostFactory" Condition="'$(IsTestProject)' != 'true' and '$(DotNESLocalDev)' == 'true'" />
  <!-- NuGet package consumers: run in-process for performance -->
  <UsingTask TaskName="dotnes.TranspileToNES" AssemblyFile="$(_NESTasksAssembly)"
             Condition="'$(IsTestProject)' != 'true' and '$(DotNESLocalDev)' != 'true'" />
  <Target Name="_WriteNESPropertiesStamp" Condition="'$(IsTestProject)' != 'true'">
    <WriteLinesToFile
        File="$(_NESPropertiesStampFile)"
        Lines="NESMirroring=$(NESMirroring);NESMapper=$(NESMapper);NESPrgBanks=$(NESPrgBanks);NESChrBanks=$(NESChrBanks);NESBattery=$(NESBattery);NESMmc3BankedLayout=$(NESMmc3BankedLayout);NESOptimizeByteHelpers=$(NESOptimizeByteHelpers);@(NESPrgBank->'%(FullPath)|%(Bank)|%(CpuAddress)|%(Offset)');@(NESChrBank->'%(FullPath)|%(Bank)|%(Offset)')"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_NESPropertiesStampFile)" />
    </ItemGroup>
  </Target>
  <Target Name="Transpile" AfterTargets="Build"
      Condition="'$(IsTestProject)' != 'true'"
      DependsOnTargets="$(TranspileDependsOn)"
      Inputs="$(TargetPath);@(NESAssembly);@(NESPrgBank);@(NESChrBank);$(_NESPropertiesStampFile);$(_NESTasksAssembly)" Outputs="$(NESTargetPath)">
    <ItemGroup>
      <_NESAssembly Include="@(NESAssembly)" />
      <_NESAssembly Remove="@(NESPrgBank);@(NESChrBank)"
                    MatchOnMetadata="FullPath"
                    MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <TranspileToNES
        TargetPath="$(TargetPath)"
        AssemblyFiles="@(_NESAssembly)"
        OutputPath="$(NESTargetPath)"
        DiagnosticLogging="$(NESDiagnosticLogging)"
        NESOptimizeByteHelpers="$(NESOptimizeByteHelpers)"
        NESMirroring="$(NESMirroring)"
        NESMapper="$(NESMapper)"
        NESPrgBanks="$(NESPrgBanks)"
        NESChrBanks="$(NESChrBanks)"
        NESBattery="$(NESBattery)"
        NESMmc3BankedLayout="$(NESMmc3BankedLayout)"
        NESPrgBank="@(NESPrgBank)"
        NESChrBank="@(NESChrBank)"
    />
    <ItemGroup>
      <FileWrites Include="$(NESTargetPath)" />
    </ItemGroup>
  </Target>
</Project>